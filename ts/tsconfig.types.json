// tsc -p ts/tsconfig.types.json -> para compilar los maps
{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./types",

    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,

    "module": "nodenext",
    "target": "esnext",

    "strict": true,
    "skipLibCheck": true
  },

  "include": ["src"]
}
